-- 2. BASIC SELECT, WHERE, LIKE, IN, LIMIT & AGGREGATE FUNCTIONS
-- =====================================================================

-- 1. View all employees
SELECT * FROM employees;

-- 2. Filter records using WHERE (Salary > 50000)
SELECT * FROM employees WHERE salary > 50000;

-- 3. Filter using BETWEEN
SELECT * FROM employees 
WHERE salary BETWEEN 50000 AND 80000;

-- 4. Using IN operator (Filter for specific departments)
SELECT * FROM employees 
WHERE department IN ('IT', 'HR');

-- 5. Using LIKE operator (Pattern matching - Names starting with 'R')
SELECT * FROM employees 
WHERE employee_name LIKE 'R%';

-- 6. Using LIMIT (Get top 5 highest paid employees)
SELECT * FROM employees 
ORDER BY salary DESC 
LIMIT 5;

-- 7. Count total employees
SELECT COUNT(*) AS total_employees FROM employees;

-- 8. Maximum salary
SELECT MAX(salary) AS max_salary FROM employees;

-- 9. Minimum salary
SELECT MIN(salary) AS min_salary FROM employees;

-- 10. Average salary
SELECT AVG(salary) AS avg_salary FROM employees;

-- 11. Sum of all salaries
SELECT SUM(salary) AS total_salary FROM employees;

-- 12. Unique departments
SELECT DISTINCT department FROM employees;

-- 13. Order by salary descending
SELECT * FROM employees 
ORDER BY salary DESC;


