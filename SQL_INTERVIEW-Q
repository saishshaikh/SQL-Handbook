-- --- SUBQUERIES & SALARY ANALYSIS ---
-- Highest salary
SELECT MAX(salary) AS Highest_Salary FROM Employee;

-- Second highest salary
SELECT MAX(salary) AS Second_Highest_Salary
FROM Employee
WHERE salary < (SELECT MAX(salary) FROM Employee);

-- Employees earning more than the company average salary
SELECT * FROM Employee
WHERE salary > (SELECT AVG(salary) FROM Employee);

-- Employees without a department
SELECT * FROM Employee WHERE dept_id IS NULL;


-- --- WINDOW FUNCTIONS (RANK, DENSE_RANK, ROW_NUMBER) ---

-- 1. Row Number based on salary
SELECT emp_name, salary,
       ROW_NUMBER() OVER (ORDER BY salary DESC) AS row_num
FROM Employee;

-- 2. Difference between RANK() and DENSE_RANK()
SELECT emp_name, salary,
       RANK() OVER (ORDER BY salary DESC) AS rnk,
       DENSE_RANK() OVER (ORDER BY salary DESC) AS dense_rnk
FROM Employee;

-- 3. Nth Highest Salary using DENSE_RANK (e.g., N=3)
SELECT salary 
FROM (
    SELECT salary, DENSE_RANK() OVER (ORDER BY salary DESC) AS rnk 
    FROM Employee
) t 
WHERE rnk = 3;

-- 4. Highest salary per department
SELECT dept_id, MAX(salary) AS max_salary
FROM Employee
GROUP BY dept_id;

-- 5. Second highest salary per department (Partition By)
SELECT salary, dept_id 
FROM (
    SELECT dept_id, salary, 
           DENSE_RANK() OVER (PARTITION BY dept_id ORDER BY salary DESC) AS rnk
    FROM Employee
) t 
WHERE rnk = 2;


-- =====================================================================
-- 7. DUPLICATE HANDLING & CTES
-- =====================================================================

-- Find duplicate records by name
SELECT emp_name, COUNT(*) 
FROM Employee 
GROUP BY emp_name 
HAVING COUNT(*) > 1;

-- Delete duplicate records (keeping the lowest emp_id)
DELETE FROM Employee
WHERE emp_id NOT IN (
    SELECT emp_id
    FROM (
        SELECT MIN(emp_id) AS emp_id
        FROM Employee
        GROUP BY emp_name
    ) t
);

-- Common Table Expression (CTE) example
WITH HighEarners AS (
    SELECT *
    FROM Employee
    WHERE salary > 50000
)
SELECT * FROM HighEarners;
